  <activity class="@associations.ComplexAssociation" name="L1A1" code="">
   <description>
    <p>Un juego para conectar a los personajes de los fragmentos de La Ilíada y La Odisea con sus descripciones o acciones clave.</p>
   </description>
   <messages>
    <cell type="initial">
     <style />
     <p>Conecta a los personajes de los fragmentos de La Ilíada y La Odisea con sus descripciones o acciones clave.</p>
    </cell>
    <cell type="final">
     <style />
     <media type="RUN_CLIC_ACTIVITY" level="1" file="L1A2" />
     <p>¡Correcto, lo lograste!, vamos con la siguiente actividad.</p>
    </cell>
    <cell type="finalError">
     <style />
     <p>⚠️ ¡Ups!, Error, inténtalo de nuevo.</p>
    </cell>
   </messages>
   <settings margin="1" report="true" reportActions="false">
    <container bgColor="0xCCCCFF">
     <gradient source="0xFFFFFF" dest="0x0D1D51" angle="0" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFFFFF" border="true" />
   </settings>
   <cells rows="2" cols="3" cellWidth="200.0" cellHeight="50.0" border="true" id="primary">
    <style margin="1">
     <color background="0xFFFFFF" />
    </style>
    <shaper class="@Rectangular" cols="3" rows="2" />
    <cell id="0">
     <p>Aquiles </p>
    </cell>
    <cell id="1">
     <p>Agamenón </p>
    </cell>
    <cell id="2">
     <p>Odiseo </p>
    </cell>
    <cell id="3">
     <p>Atenea </p>
    </cell>
    <cell id="4">
     <p>Poseidón</p>
    </cell>
    <cell id="5">
     <p>Ninguno</p>
    </cell>
   </cells>
   <cells rows="2" cols="3" cellWidth="200.0" cellHeight="50.0" border="true" id="secondary">
    <style margin="1">
     <color background="0xFFFFFF" />
    </style>
    <shaper class="@Rectangular" cols="3" rows="2" />
    <cell>
     <p>el de los pies ligeros</p>
    </cell>
    <cell>
     <p>el rey de hombres</p>
    </cell>
    <cell>
     <p>detenido en hueca gruta por Calipso</p>
    </cell>
    <cell>
     <p>exhorta a Telémaco</p>
    </cell>
    <cell>
     <p>constantemente irritado contra el divinal Odiseo</p>
    </cell>
    <cell>
     <p>Ninguno</p>
    </cell>
   </cells>
   <scramble times="31" primary="true" secondary="true" />
   <layout position="AB" />
  </activity>
  <activity class="@text.FillInBlanks" name="L1A2" code="">
   <description>
    <p>Una actividad para completar los versos del poema de Rosalía de Castro con las palabras correctas</p>
   </description>
   <messages>
    <cell type="initial">
     <style />
     <p>Rellena con las palabras correctas, para completar los versos del poema de Rosalía de Castro. </p>
    </cell>
    <cell type="final">
     <style />
     <media type="RUN_CLIC_ACTIVITY" level="1" file="L1A3" />
     <p>¡Correcto, lo lograste!, vamos con la siguiente actividad.</p>
    </cell>
    <cell type="finalError">
     <style />
     <p>⚠️ ¡Ups! 😅 Error, inténtalo de nuevo.</p>
    </cell>
   </messages>
   <settings margin="2" report="true" reportActions="false">
    <container bgColor="0x0066CC">
     <gradient source="0xFFFFFF" dest="0x003366" angle="0" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFFFFF" border="true">
     <size width="400" height="101" />
    </window>
   </settings>
   <document>
    <style name="targetError" base="target" foreground="0xFF0000" />
    <style name="target" base="default" foreground="0x0000FF" target="true" />
    <style name="default" family="Arial" background="0xFFFFFF" size="11" bold="false" italic="false" tabWidth="12" />
    <section>
     <p family="Arial" background="0xFFFFFF" Alignment="1">
      <text size="12">"Cuando imagino que te has ido, en el mismo </text>
      <target>
       <answer>sol</answer>
       <response fill="_" length="3" maxLength="3" />
       <text>sol</text>
      </target>
      <text size="12"> te me muestras".</text>
     </p>
     <p family="Arial" background="0xFFFFFF" Alignment="1" />
     <p family="Arial" background="0xFFFFFF" Alignment="1">
      <text size="12">"y eres la </text>
      <target>
       <answer>estrella</answer>
       <response fill="_" length="8" maxLength="8" />
       <text>estrella</text>
      </target>
      <text size="12"> que brilla, y eres el viento que zumba".</text>
     </p>
     <p family="Arial" background="0xFFFFFF" Alignment="1" />
     <p family="Arial" background="0xFFFFFF" Alignment="1">
      <text size="12">"y eres el murmullo del río y eres la noche y eres la </text>
      <target>
       <answer>aurora</answer>
       <response fill="_" length="6" maxLength="6" />
       <text>aurora</text>
      </target>
      <text size="12">"</text>
     </p>
    </section>
   </document>
   <evaluator class="@ComplexEvaluator" />
  </activity>
  <activity class="@puzzles.ExchangePuzzle" name="L1A3" code="">
   <description>
    <p>El estudiante debe arrastrar frases y conceptos clave de los fragmentos leídos y soltarlos en la categoría correcta: "La Ilíada" o "La Odisea".</p>
   </description>
   <messages>
    <cell type="initial">
     <style />
     <p>Ordena para identificar la escena de la obra "La Iliada".</p>
    </cell>
    <cell type="final">
     <style />
     <media type="RUN_CLIC_ACTIVITY" level="1" file="Sm_2" />
     <p>¡Correcto, lo lograste!, vamos con la siguiente Unidad.</p>
    </cell>
    <cell type="finalError">
     <style />
     <p>⚠️ ¡Ups!, Error, inténtalo de nuevo.</p>
    </cell>
   </messages>
   <settings margin="1" dragCells="true" report="true" reportActions="false">
    <container bgColor="0x000033">
     <gradient source="0xFFFFFF" dest="0x0D1D51" angle="0" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFFFFF" border="true" />
   </settings>
   <cells rows="2" cols="3" border="true" image="Iliada-resized.jpg">
    <style borderStroke="4.1" markerStroke="2.7">
     <color foreground="0xFFFFFF" background="0xFFFFFF" inactive="0xFFFFFF" border="0xFFFFFF" />
    </style>
    <shaper class="@ClassicJigSaw" cols="3" rows="2" />
   </cells>
   <scramble times="31" />
  </activity>
