     <color background="0xFFFFFF" border="0xFFFF00" />
    </style>
    <shaper class="@Rectangular" cols="3" rows="1" />
    <cell>
     <p>Narrativa</p>
    </cell>
    <cell>
     <p>Lírico</p>
    </cell>
    <cell>
